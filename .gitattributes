# Normalise line endings in the repository; check out with the platform's own.
* text=auto

*.rs text diff=rust
*.toml text
*.md text diff=markdown
*.yml text
*.json text
*.csv text
*.py text diff=python

*.png binary

# The reference runs are the tools' own output, compared byte for byte (refemu follows an
# event log by its text): always LF, on every platform.
ports/*/reference/** text eol=lf
