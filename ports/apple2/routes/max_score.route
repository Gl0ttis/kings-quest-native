# Maximum-score route through King's Quest (Apple II), derived from the room scripts.
# Run with: kqroute extracted/disk1.do extracted/disk2.do extracted/disk3.do routes/max_score.route

# Room 3: the dagger under the rock (rock 2 points, dagger 5).
room 3
area 109 110 135 130
say move rock
wait 30
expect score 2
say get dagger
expect score 7

# Room 6: look into the stump (1), take the pouch (3), open it: diamonds (3).
room 6
area 1 96 33 143
say look stump
wait 5
say get pouch
say open pouch
expect score 14

# Room 12: cut the well rope with the dagger, take the bucket (2).
room 12
area 10 109 71 153
say cut rope
expect score 16

# Room 15: walk into the carrot patch from below (sets v142), pick a carrot (2).
room 15
goto 90 152
goto 90 132
say get carrot
expect score 18

# Room 11: open the corral gate, walk in through it (v121), show the goat the carrot (5).
room 11
area 1 132 56 166
say open gate
wait 10
goto 30 158
goto 30 140
# The goat starts in the room-10 half of the corral (v53 = 10): go there inside the fence.
edge L
say show carrot
expect score 23
# Wait for the goat to reach Graham: it merges into his sprite (view 67, v40 = 1). Until
# then room 11's gateway is barred ("You're not leaving without him").
waitvar 40 1 400
# Back into room 11 and out through the gate.
edge R
goto 30 140
goto 30 160

# Room 25: step onto the bridge (the troll appears), then the goat butts it off (4).
# Go round by room 22: the direct way left lands inside the corral again in room 10.
room 22
room 24
room 25
area 5 93 66 94
wait 5
area 13 91 66 92
wait 30
expect score 27

# Small items. Room 24: four-leaf clover (2).
room 24
area 25 108 80 154
say get clover
expect score 29
# Room 30: walnut (3), opening it reveals gold (3).
room 30
area 9 112 98 166
say get gold nut
say open gold nut
expect score 35
# Room 31: bowl (3).
room 31
area 114 126 146 148
say get bowl
expect score 38
# The word on its bottom (+1); this needs the bowl, so before the woodcutter.
say read bowl
expect score 39
# Room 34: pebbles (1).
room 34
area 68 83 94 109
say get pebble
expect score 40
# Deferred: the mushroom in room 47 (1, and 3 for eating it later). Lakes cut its side
# of the room off from rooms 33, 34 and 46 on foot; reaching it needs swimming support.

# Woodcutter's cottage (room 44 -> 79). Giving the empty bowl first scores most:
# give it (+6 -3), "fill bowl" in front of them (+2), then take the fiddle (+3).
room 44
enter 79 128 105 138 127
say give bowl
say fill bowl
area 120 140 158 166
say get fiddle
expect score 48
# Out through the cottage door.
enter 44 16 103 20 128

# The elf (room 18) appears when the random bit v14 is 1 on entry; the autopilot
# re-times the arrival until it does. Speaking to him gives the magic ring.
room 31
room 18
require 101 1
say speak elf
expect score 51

# The castle door (room 2): open it from the doorstep; the door leads to room 55.
room 2
area 97 120 124 126
say open door
expect score 52
waitvar 1 55 200
wait 4
# Up the hall (room 55 -> 54 -> 53) and bow to the king, not too close.
enter 54 1 1 158 72
room 53
area 60 100 90 120
say bow king
expect score 55

# The well (room 12): lower the rope, then climb onto it from the rim; climbing down
# to y 133 (x 37-43) takes Graham into the well (room 49, +1 on arrival).
room 12
area 10 109 71 150
say lower rope
say climb rope
waitvar 126 3 100
hold D
waitvar 1 49 200
wait 4
expect score 56
# Climb down the rope (x 77-84; leaving it falls) into the water: Graham swims (v24).
hold D
waitvar 24 1 200
say get water
expect score 58
# Dive: under the water to room 52 (+2).
say dive
waitvar 1 52 200
wait 4
expect score 60
# Through the hole to the dragon's cave (room 51, +1). Douse the dragon from outside
# [105,96,145,166] (+5), take the mirror (+8), and leave by the far side (room 50).
room 51
expect score 61
goto 100 136
say douse dragon
expect score 66
wait 20
area 26 104 59 127
say get mirror
expect score 74

# The gnome (room 40): ask him, then his name first time (+5): Rumpelstiltskin written
# with the alphabet reversed. He leaves magic beans (+4).
room 40 10 100 90 150
area 10 100 90 150
say speak gnome
wait 3
say ifnkovhgroghprm
expect score 79
wait 3
say get beans
expect score 83

# The witch's house (room 28 -> 65). The witch is home only if the random bit v14 is
# set on entry and no protective spell is active (v56 = 0); she gives the most points.
# Each entry to room 28 toggles v154 (the witch alerted, set on odd entries); she can
# only be caught off guard on an even entry, so step out to room 37 and back first.
room 28
room 37
room 28 40 127 70 135
area 40 127 70 135
say open door
waitvar 1 65 200
wait 4
require 110 1
# Wait on the right side (x >= 100) while she appears and goes to heat her oven; once
# she is busy at it (v101 = 2), step up behind her to push her in (+7).
area 110 120 140 150
waitvar 101 2 600
area 34 110 40 128
waitvar 49 1 200
expect score 90
# The cabinet (+2 when it opens), the cheese (+2), and the note on the table (+2).
area 23 89 55 100
say open cabinet
wait 30
say get cheese
area 114 132 140 160
say get note
expect score 96
# Out by the door, and eat some of the house (+2).
area 42 158 58 162
hold D
waitvar 1 28 60
wait 4
area 20 120 110 135
say eat house
expect score 98

# The mushroom (room 47): on the east bank of the Raging River, reached from room 48.
room 48
room 47 64 61 114 101
area 64 61 114 101
say get mushroom
expect score 99

# The hole in room 48 (priority-0 ground around x 66-88, y 114-128) drops Graham into the
# tunnels (room 73).
room 48
enter 73 70 116 82 124 water
# Graham falls, tumbles and gets up (v101 = 2) before he can walk.
waitvar 101 2 300

# The rat (room 75) chases Graham and kills on contact; giving it the cheese from
# x <= 116 sends it into the wall (+4, -2 for the cheese). Then open the door and go
# west to the leprechauns (room 76).
room 75
area 95 112 112 146
say give cheese
expect score 101
wait 20
area 24 103 43 125
say open door
wait 20
# In the doorway [24,106,38,121] the script lets Graham through the wall; walk west.
area 26 108 36 119
hold L
waitvar 1 76 100
wait 4
# Room 76: playing the fiddle sends the leprechauns dancing away (+3).
say play fiddle
expect score 104
waitvar 211 1 200
# Room 77 (south): the leprechaun king walks off and leaves his sceptre (v213 = 1).
# The shield (+8) and the sceptre (+6) can both be taken from x 121-142, y 118-138.
room 77
waitvar 213 1 800
area 121 118 142 138
say get shield
expect score 112
say get scepter
expect score 118
# West to room 78 (the exit works at y 78-102): eat the mushroom (+3) to shrink, and
# leave west through the small hole (+1). Eating it scores +3 but the mushroom item's
# point goes with it (net +2).
area 12 82 16 98
hold L
waitvar 1 78 100
wait 4
say eat mushroom
expect score 120
edge L
expect score 121

# The note (+1 for reading it).
say read note
expect score 122

# The condor (room 22) appears when the random bit v14 is 1 on entry and the beanstalk
# hasn't been planted. If it touches Graham while he is in mid-jump, it carries him
# off (+3) to room 80.
room 27
room 22
wait 4
require 101 1
area 60 100 100 130
jumpuntil 149 1 1500
waitvar 1 80 300
expect score 125
# The condor flies to room 48 and drops Graham there.
waitvar 1 48 600
wait 4

# The beanstalk: plant the beans in room 6 (+2), standing clear of where it grows
# ([49,1,97,124]), then climb it from its base ([58,80,83,87]) and go straight up to
# the clouds (room 70). Moving sideways off the stalk (x 57-59 or 82-84) falls.
room 6 110 128 140 150
area 110 128 140 150
say plant beans
expect score 127
waitvar 35 1 400
wait 10
area 66 81 76 86
say climb beanstalk
waitvar 107 1 100
hold U
waitvar 1 70 400
wait 4
# Room 70 is the top of the stalk: Graham must stay on it (x 60-77 below y 116,
# x 66-79 above) or he falls. The stalk's own band-B pixels block x 70 at y 128-135,
# so climb at x 76.
area 76 138 77 141
hold U
waitvar 1 71 400
wait 4
# Room 71: more stalk (safe x 66-76 below y 101, 65-76 up to y 56, then 62-74). The
# stalk's band-7 pixels block Graham while his own priority is 7 (y 96-103), so pass
# that stretch at x 76, then move back to x 72 before y 56.
area 76 100 76 106
area 76 56 76 64
area 72 56 72 64
hold U
waitvar 1 72 400
wait 4
# Room 72: climb to the cloud bank and step off the stalk to the right ([75,50,158,124]
# turns Graham back into his walking self). Anywhere outside the stalk and the two
# cloud banks he falls.
keepin 46 94 113 115 112 68 158 124 65 50 74 166
area 69 102 70 110
area 80 100 100 116

# The giant (room 58). With the shield (a protection, v56 != 0) he only wanders; after
# about three timer rounds (v12 = 250, v187 = 2) he lies down and sleeps (+7). Then the
# chest by him (+8).
room 58
waitvar 186 1 3000
expect score 134
area 27 76 64 100
say get chest
expect score 142

# The sling (room 62).
room 62 112 100 142 128
# y <= 52 leads back to room 59, y >= 152 falls through the clouds.
keepin 11 54 140 150
area 112 100 142 128
say get sling
expect score 144
# Leave by the top (y <= 52 leads to room 59), still clear of the fatal bottom band.
keepin 11 1 140 150
room 59
keepin

# Back down the beanstalk: room 56's west exit leads to room 72 once the beans are
# planted (v105). Step onto the stalk there and climb down through rooms 71 and 70
# (the same band-priority detours as on the way up) to room 6.
room 72
keepin 46 94 113 115 112 68 158 124 65 50 74 166
area 66 100 70 110
waitvar 107 1 50
hold D
waitvar 1 71 400
wait 4
keepin 66 101 76 166 65 56 76 101 62 1 74 56
area 69 44 70 54
area 76 56 76 64
area 76 98 76 106
hold D
waitvar 1 70 400
wait 4
keepin 60 115 77 166 66 1 79 116
area 76 44 76 52
hold D
waitvar 1 6 400
wait 4
keepin
hold D
waitvar 107 0 400

# The eagle's nest: climb the tree in room 14 from [75,131,158,166] into the treetop
# (room 63, +2) and take the golden egg (+6).
room 14 80 135 150 160
area 80 135 150 160
say climb tree
waitvar 1 63 100
wait 4
expect score 146
area 51 70 97 102
say get egg
expect score 152

# Home with the three treasures (chest, mirror, shield: v62 = 1 re-arms the castle
# door, +1 again). Bow to the king (+3) and the ending plays.
room 2 97 120 124 126
area 97 120 124 126
# Dousing the dragon took back the bucket's 2 points; refill it from the moat (room 2's
# water rectangle [10,120,158,166] includes the doorstep).
say get water
expect score 154
say open door
expect score 155
waitvar 1 55 200
wait 4
enter 54 1 1 158 72
room 53
area 60 100 90 120
say bow king
expect score 158
# The King dies and Graham may move again (v178 = 5): walking to the throne side
# ([1,82,60,106]) crowns him and ends the game.
waitvar 178 5 800
final 3 84 58 104
wait 100
